{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enest.local/schemas/registry.json",
  "title": "eNest plugin registry",
  "type": "object",
  "required": ["schemaVersion", "plugins"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "channel": { "type": "string", "enum": ["stable", "beta", "dev"] },
    "categories": {
      "type": "array",
      "items": { "type": "string" }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "version", "category", "asset"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "version": { "type": "string" },
          "description": { "type": "string" },
          "author": { "type": "string" },
          "category": { "type": "string" },
          "icon": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "permissions": { "type": "array", "items": { "type": "string" } },
          "featured": { "type": "boolean" },
          "installs": { "type": "number" },
          "engines": {
            "type": "object",
            "properties": { "enest": { "type": "string" } }
          },
          "ui": {
            "type": "object",
            "description": "透传 plugin.json 的 ui 段；缺省等价 chrome=none / themeAware=true / background=opaque / preferredColorScheme=auto",
            "properties": {
              "chrome": { "enum": ["default", "minimal", "none"] },
              "themeAware": { "type": "boolean" },
              "background": { "enum": ["opaque", "transparent"] },
              "preferredColorScheme": { "enum": ["auto", "light", "dark"] }
            },
            "additionalProperties": false
          },
          "asset": {
            "type": "object",
            "required": ["name", "url"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^.+@\\d+\\.\\d+\\.\\d+.*\\.enestplugin$"
              },
              "url": { "type": "string" },
              "size": { "type": "number" },
              "sha256": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
