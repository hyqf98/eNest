{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enest.local/schemas/plugin-manifest.json",
  "title": "eNest plugin.json",
  "type": "object",
  "required": ["id", "name", "version", "main", "description"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
      "description": "全局唯一反向域名，必须与目录名一致"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+].*)?$"
    },
    "description": { "type": "string", "maxLength": 200 },
    "author": { "type": "string" },
    "logo": {
      "type": "string",
      "description": "插件图标文件相对路径（png/svg），市场卡片与大图头展示"
    },
    "main": { "type": "string", "default": "index.html" },
    "category": {
      "type": "string",
      "enum": ["效率", "开发", "设计", "媒体", "其它"]
    },
    "icon": { "type": "string" },
    "homepage": { "type": "string" },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "clipboard.read",
          "clipboard.write",
          "clipboard.readImage",
          "clipboard.writeImage",
          "clipboard.history",
          "screen.capture",
          "screen.record",
          "pin.create",
          "net.fetch",
          "shell.openExternal",
          "storage.local",
          "notify",
          "ui.setTitle",
          "ui.setIcon",
          "ui.setBadge",
          "ui.resize",
          "ui.toast",
          "settings.register",
          "settings.page",
          "hotkey",
          "contribute",
          "vault.write",
          "ssh.session",
          "ssh.exec",
          "ssh.sftp",
          "db.connect",
          "db.query",
          "db.schema"
        ]
      },
      "description": "API 白名单（与 src/shared/types/plugin.ts 的 PLUGIN_PERMISSIONS 一一对应）"
    },
    "engines": {
      "type": "object",
      "properties": {
        "enest": {
          "type": "string",
          "description": "壳子版本范围：支持 * / ^x.y.z / >=x.y.z / 精确 x.y.z；复杂范围安装时拒绝"
        }
      }
    },
    "features": {
      "type": "array",
      "description": "可搜索指令（Quick 命令面板 feature 集合）",
      "items": {
        "type": "object",
        "required": ["code", "cmds"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "description": "指令码，openPlugin 载荷 code 与之对应"
          },
          "explain": { "type": "string", "description": "指令说明（命令面板副标题）" },
          "cmds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "description": "触发关键词"
          }
        },
        "additionalProperties": false
      }
    },
    "window": {
      "type": "object",
      "description": "建议窗口最小尺寸",
      "properties": {
        "minWidth": { "type": "number", "minimum": 200 },
        "minHeight": { "type": "number", "minimum": 200 }
      },
      "additionalProperties": false
    },
    "form": {
      "type": "string",
      "enum": ["mini", "panel"],
      "description": "打开形态：mini 命令面板小窗优先 / panel 主窗 Tab（缺省）"
    },
    "development": {
      "type": "object",
      "description": "开发态配置（开发者控制台加载时使用）",
      "properties": {
        "main": {
          "type": "string",
          "description": "开发服务器入口 URL（Vite/Webpack dev server）"
        }
      },
      "additionalProperties": false
    },
    "settings": {
      "type": "string",
      "description": "设置页 HTML 相对路径（保留/实验字段，壳子尚未消费）"
    },
    "ui": {
      "type": "object",
      "description": "UI 集成配置；缺省等价 chrome=none / themeAware=true / background=opaque / preferredColorScheme=auto",
      "properties": {
        "chrome": {
          "enum": ["default", "minimal", "none"],
          "description": "default 已废弃（等价 none）；minimal 细条 28px；none 无条全幅（缺省）"
        },
        "themeAware": { "type": "boolean" },
        "background": { "enum": ["opaque", "transparent"] },
        "preferredColorScheme": { "enum": ["auto", "light", "dark"] }
      },
      "additionalProperties": false
    },
    "market": {
      "type": "object",
      "properties": {
        "featured": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "screenshots": { "type": "array", "items": { "type": "string" } }
      }
    },
    "contributes": {
      "type": "object",
      "description": "贡献点声明（插槽化架构）：声明式注册，安装/扫描时入库，重启即显示，不依赖插件运行。schemaVersion 缺省视为当前版本（'1'），不匹配时拒绝",
      "properties": {
        "settings": {
          "type": "array",
          "description": "设置 section：壳子设置页插件分组；等价运行时 enest.settings.register",
          "items": {
            "type": "object",
            "required": ["id", "title", "items"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "schemaVersion": { "type": "string" },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["key", "type", "label"],
                  "properties": {
                    "key": { "type": "string", "minLength": 1 },
                    "type": {
                      "type": "string",
                      "enum": [
                        "text",
                        "string",
                        "switch",
                        "boolean",
                        "bool",
                        "select",
                        "number",
                        "slider",
                        "color",
                        "page"
                      ],
                      "description": "控件类型；slider 需 min/max/step；color 渲染颜色输入；page 为预留（settings.page 权限）"
                    },
                    "label": { "type": "string", "minLength": 1 },
                    "default": {},
                    "options": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["label", "value"],
                        "properties": {
                          "label": { "type": "string" },
                          "value": {}
                        }
                      }
                    },
                    "min": { "type": "number" },
                    "max": { "type": "number" },
                    "step": { "type": "number", "exclusiveMinimum": 0 }
                  }
                }
              }
            }
          }
        },
        "homeCards": {
          "type": "array",
          "description": "首页卡片：市场页（首页）「插件扩展」区块",
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "glyph": { "type": "string", "maxLength": 2 },
              "color": { "type": "string" },
              "explain": { "type": "string" },
              "openCode": {
                "type": "string",
                "description": "点击卡片 openPlugin 时透传的 feature code"
              },
              "schemaVersion": { "type": "string" }
            }
          }
        },
        "railEntries": {
          "type": "array",
          "description": "左侧轨道入口（orb 模式）：数据层已下发，渲染消费见工程文档交接说明",
          "items": {
            "type": "object",
            "required": ["id", "glyph"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "glyph": { "type": "string", "minLength": 1, "maxLength": 2 },
              "color": { "type": "string" },
              "title": { "type": "string" },
              "openCode": { "type": "string" },
              "schemaVersion": { "type": "string" }
            }
          }
        },
        "themePacks": {
          "type": "array",
          "description": "主题包（并入统一语义，等价运行时 enest.theme.register；source 强制绑插件 id）",
          "items": { "type": "object" }
        },
        "quickProviders": {
          "type": "array",
          "description": "保留字段：Quick 搜索 provider 仅支持运行时注册（enest.contribute.registerQuickProvider），manifest 声明不生效",
          "items": { "type": "object" }
        }
      }
    }
  },
  "additionalProperties": true
}
