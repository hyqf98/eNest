{
  "id": "com.enest.translate",
  "name": "翻译",
  "version": "1.0.0",
  "description": "谷歌翻译引擎，自动检测语言，一键复制译文",
  "author": "Lingua",
  "main": "index.html",
  "category": "效率",
  "icon": "icon.svg",
  "form": "mini",
  "engines": {
    "enest": ">=0.1.0"
  },
  "permissions": [
    "net.fetch",
    "clipboard.read",
    "clipboard.write",
    "storage.local",
    "ui.setTitle",
    "ui.toast"
  ],
  "window": {
    "minWidth": 420,
    "minHeight": 320
  },
  "features": [
    {
      "code": "main",
      "explain": "翻译文本",
      "cmds": [
        "翻译",
        "translate",
        "fy"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "featured": true,
    "tags": [
      "翻译",
      "谷歌",
      "效率"
    ],
    "minWidth": 420,
    "minHeight": 320
  }
}
