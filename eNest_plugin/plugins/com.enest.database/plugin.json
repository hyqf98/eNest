{
  "id": "com.enest.database",
  "name": "数据库",
  "version": "1.0.0",
  "description": "桌面级 SQL 客户端：连接管理、IDEA 式补全、结果集增删改批、控制台会话持久化",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "开发",
  "icon": "icon.svg",
  "form": "panel",
  "engines": {
    "enest": ">=0.1.0"
  },
  "permissions": [
    "vault.write",
    "db.connect",
    "db.query",
    "db.schema",
    "storage.local",
    "ui.setTitle",
    "ui.toast",
    "notify",
    "clipboard.write",
    "shell.openExternal",
    "settings.register"
  ],
  "contributes": {
    "settings": [
      {
        "id": "database.prefs",
        "title": "数据库",
        "items": [
          {
            "key": "followShellTheme",
            "type": "switch",
            "label": "跟随壳子主题",
            "default": true
          }
        ]
      }
    ]
  },
  "window": {
    "minWidth": 1100,
    "minHeight": 700
  },
  "features": [
    {
      "code": "main",
      "explain": "数据库客户端",
      "cmds": ["数据库", "database", "sql", "mysql", "sqlite"]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "featured": true,
    "tags": ["数据库", "SQL", "开发", "MySQL", "SQLite"],
    "minWidth": 1100,
    "minHeight": 700
  }
}
