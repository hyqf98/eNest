{
  "id": "com.enest.screen-assistant",
  "name": "屏幕助手",
  "version": "1.0.0",
  "description": "矩形截图、矩形录屏（可选声音）与截图贴到屏幕",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "媒体",
  "icon": "icon.svg",
  "engines": {
    "enest": ">=0.1.0"
  },
  "permissions": [
    "screen.capture",
    "screen.record",
    "pin.create",
    "clipboard.writeImage",
    "storage.local",
    "ui.setTitle",
    "ui.toast"
  ],
  "window": {
    "minWidth": 480,
    "minHeight": 360
  },
  "features": [
    {
      "code": "capture",
      "explain": "矩形截图",
      "cmds": [
        "截图",
        "screenshot",
        "截屏"
      ]
    },
    {
      "code": "record",
      "explain": "矩形录屏",
      "cmds": [
        "录屏",
        "record"
      ]
    },
    {
      "code": "pin",
      "explain": "贴图",
      "cmds": [
        "贴图",
        "pin"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "featured": true,
    "tags": [
      "截图",
      "录屏",
      "贴图"
    ],
    "minWidth": 480,
    "minHeight": 360
  }
}
