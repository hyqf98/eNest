{
  "name": "enest",
  "version": "0.0.1",
  "description": "eNest — 插件化桌面壳子",
  "desktopName": "com.github.eNest.shell.desktop",
  "main": "./out/main/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node src/main/dev/devLauncher.mjs dev",
    "build": "electron-vite build",
    "start": "node src/main/dev/devLauncher.mjs preview",
    "api-types": "node eNest_plugin/scripts/generate-api-types.mjs --host-root .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src --ext .ts,.tsx",
    "dev:debug": "node src/main/dev/devLauncher.mjs dev --debug",
    "pack:dir": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "electron:install": "install-electron",
    "native:build": "node native/clipboard/build.mjs",
    "predev": "npm run electron:install && npm run native:build",
    "predev:debug": "npm run electron:install && npm run native:build",
    "prestart": "npm run electron:install",
    "prebuild": "npm run native:build",
    "postbuild": "node tools/packaging/collect-bundled-licenses.mjs",
    "associations:check": "node scripts/generate-builder-associations.mjs check",
    "audit:source": "node scripts/audit-source-boundaries.mjs",
    "audit:contracts": "node scripts/audit-plugin-contracts.mjs",
    "test:packaging": "node --test tests/packaging/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "adm-zip": "^0.6.1",
    "ajv": "^8.20.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "gsap": "^3.12.5",
    "js-yaml": "4.3.2",
    "pinyin-pro": "^3.29.5",
    "playwright-core": "^1.63.0",
    "react": "^18.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "undici": "6.29.0",
    "vite": "8.3.5",
    "zustand": "^5.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "author": {
    "name": "eNest",
    "email": "dev@enest.local"
  }
}
