{
  "name": "enest",
  "version": "0.1.0",
  "description": "eNest — 插件化桌面壳子",
  "main": "./out/main/index.js",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "postinstall": "node scripts/patch-electron-app.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src --ext .ts,.tsx",
    "e2e:smoke": "node scripts/e2e-smoke.mjs",
    "dev:debug": "ENEST_REMOTE_DEBUG=9222 electron-vite dev",
    "pack:dir": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "ajv": "^8.20.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "gsap": "^3.12.5",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^36.9.5",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20"
  },
  "author": {
    "name": "eNest",
    "email": "dev@enest.local"
  }
}
