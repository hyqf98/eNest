{
  "name": "enest",
  "version": "0.1.0",
  "description": "eNest — 插件化桌面壳子",
  "main": "./out/main/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "api-types": "node eNest_plugin/scripts/generate-api-types.mjs --host-root .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src --ext .ts,.tsx",
    "dev:debug": "ENEST_REMOTE_DEBUG=9331 electron-vite dev",
    "pack:dir": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "native:build": "node native/clipboard/build.mjs",
    "predev": "npm run native:build",
    "prebuild": "npm run native:build"
  },
  "dependencies": {
    "@clickhouse/client": "^1.24.1",
    "@duckdb/node-api": "^1.5.6-r.1",
    "@tdengine/websocket": "^3.5.0",
    "adm-zip": "^0.6.1",
    "ajv": "^8.20.0",
    "amqplib": "^2.2.0",
    "cassandra-driver": "^4.10.0",
    "csv-parse": "^7.0.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "gsap": "^3.12.5",
    "kafkajs": "^2.2.4",
    "lossless-json": "^4.3.1",
    "mongodb": "^7.7.0",
    "mqtt": "^5.16.0",
    "mssql": "^12.7.4",
    "mysql2": "^3.24.4",
    "neo4j-driver": "^6.2.0",
    "oracledb": "^26.0.0",
    "pg": "^8.23.0",
    "pg-query-stream": "^4.17.1",
    "pinyin-pro": "^3.29.5",
    "react": "^18.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^18.3.1",
    "redis": "^6.3.0",
    "ssh2": "^1.17.0",
    "undici": "^8.11.2",
    "ws": "^8.22.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.3",
    "@types/oracledb": "^7.0.3",
    "@types/pg": "^8.23.1",
    "@types/pg-query-stream": "^1.0.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.4.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@electron/rebuild": {
      "node-gyp": "^11.5.0"
    }
  },
  "author": {
    "name": "eNest",
    "email": "dev@enest.local"
  }
}
